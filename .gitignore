.venv/
__pycache__/
*.pyc

# Generated image outputs and temporary visual/test audit artifacts.
output/exports/
output/*.png
output/*.webp
_test/

# Local photo library: keep category folders, never commit original or cutout imagery.
/raw_photos/*
!/raw_photos/.gitkeep
!/raw_photos/*/
/raw_photos/*/*
!/raw_photos/*/.gitkeep
/cutouts/*
!/cutouts/.gitkeep
!/cutouts/*/
/cutouts/*/*
!/cutouts/*/.gitkeep
